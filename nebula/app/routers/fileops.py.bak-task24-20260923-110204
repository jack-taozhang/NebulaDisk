    mount: str = Form(...), path: str = Form(""), name: str = Form(...),
    user: dict = Depends(auth.current_user),
):
    m = _mount(user["username"], mount)
    r = files.mkdir(m, path, name)
    users.audit(user["username"], "mkdir", f"{mount}:{path}/{name}")
