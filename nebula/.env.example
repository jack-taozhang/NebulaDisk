# =============================================================================
# NebulaDisk 部署参数（复制成 .env 后按需修改）
#
#   cp nebula/.env.example nebula/.env
#
# 注意：.env 里可能含 OnlyOffice 密钥，不要提交进版本库。
# =============================================================================

# ---------------------------------------------------------------------------
# 镜像
# ---------------------------------------------------------------------------
NB_IMAGE=nebula:1.0.0
# 复用的 kkFileView 基础镜像（必须是已构建好的本地镜像）
NB_BASE_IMAGE=kkfileview:5.0.2
NB_VERSION=1.0.0
NB_APT_MIRROR=mirrors.aliyun.com

# ---------------------------------------------------------------------------
# 端口
# ---------------------------------------------------------------------------
# 云盘界面端口（本机 8080/8081/8082/8088 均已被占用，故用 8089）
NB_HOST_PORT=8089
# kkFileView 直连端口（排查用）。本机 8012 已被独立容器占用，
# 需要时改成 8013 并放开 compose 里对应的 ports 注释。
NB_KK_HOST_PORT=8013

# ---------------------------------------------------------------------------
# ★ 目录映射（核心配置）★
#
# 左边 = 宿主机真实目录，右边 = 容器内路径，二者必须严格对应：
#
#   volumes:
#     - /volume1/共享:/mnt/share        →  共享|/mnt/share|*
#     - /volume2/照片:/mnt/photos       →  照片|/mnt/photos|*
#     - /volume1/私密:/mnt/private      →  私密|/mnt/private|admin
#
# NAS 上典型路径：
#   群晖   /volume1/xxx
#   威联通 /share/xxx
#   绿联/Ugreen  /mnt/xxx
#   极空间 /sata/xxx
# ---------------------------------------------------------------------------

# 宿主机目录（改成你的真实路径）
NB_SHARE_DIR=./sample/share
NB_PHOTOS_DIR=./sample/photos
NB_PRIVATE_DIR=./sample/private

# 数据目录（SQLite 用户库 + 会话密钥）。**必须持久化**，否则重建容器就丢用户。
NB_DATA_DIR=./data
NB_KK_FILE_DIR=./data-kk/file
NB_KK_LOG_DIR=./data-kk/log

# 映射声明：显示名|容器内路径|可见用户
#   显示名     = 界面上看到的盘符名字（可用中文）
#   容器内路径 = 与 volumes 右侧完全一致
#   可见用户   = * 表示所有人；也可写 alice,bob；省略等同 *
NEBULA_MOUNTS=共享|/mnt/share|*;照片|/mnt/photos|*;私密|/mnt/private|admin

# ---------------------------------------------------------------------------
# 云盘
# ---------------------------------------------------------------------------
NB_TITLE=NebulaDisk
NB_ADMIN_USER=admin
# 留空 = 首启随机生成并打印到容器日志（推荐首次这样做，之后改掉）
NB_ADMIN_PASSWORD=
NB_SESSION_HOURS=12
# 单文件上传上限（MB）。超过会被 413 拒绝。
NB_MAX_UPLOAD_MB=2048
NB_LOG_LEVEL=info

# 会话签名密钥。留空 = 自动生成到 /var/lib/nebula/secret.key 并持久复用。
# 多实例/负载均衡时必须显式设成同一个值。
NB_JWT_SECRET=

# ---------------------------------------------------------------------------
# ★ OnlyOffice（复用已有容器）★
# ---------------------------------------------------------------------------
# 服务端地址：容器间互通，用服务名或 IP
NB_OO_URL=http://maple-onlyoffice

# ★ 浏览器地址：必须是用户浏览器能访问到的地址。
#   填 127.0.0.1 只在「浏览器也在同一台机器」时有效。
#   NAS 部署必须填 NAS 的真实 IP 或域名，例如：
#     http://192.168.1.10:8082
#     https://oo.example.com
NB_OO_PUBLIC=http://192.168.1.10:8082

# ★ 必须与 OnlyOffice 容器的 JWT_SECRET **完全一致**
#   查看已有容器：docker inspect maple-onlyoffice | grep -i jwt
NB_OO_SECRET=

# OnlyOffice 所在的 docker 网络名。用 docker network ls 确认真名。
NB_OO_NETWORK=deploy_default

# ---------------------------------------------------------------------------
# ★★ raw 取流直链的对外基地址（决定编辑器能不能打开文件）★★
# ---------------------------------------------------------------------------
# 原理：OnlyOffice 是用**它自己的容器**去 GET 文档的，不是浏览器发请求。
#       云盘把文档地址拼成  <NB_BASE_URL>/api/raw/<文件名>?签名  交给它。
#       所以这个地址必须是「OnlyOffice 容器能解析并访问到」的地址。
#
# 正确值：
#   - 同网络用服务名：http://nebula:8088        ← 推荐，默认就是这个
#   - 或容器网络 IP：  http://172.19.0.5:8088   （IP 会变，不推荐）
#
# 常见错误值（会表现为「编辑器一直转圈 / 下载文件失败」）：
#   - http://127.0.0.1:8088   → OnlyOffice 容器里的 127.0.0.1 是它自己
#   - http://<NAS的IP>:8089   → 容器内未必有到宿主机的路由
#
# 注意这是**容器端口 8088**，不是宿主机映射端口 8089。
NB_BASE_URL=http://nebula:8088

# ---------------------------------------------------------------------------
# 资源
# ---------------------------------------------------------------------------
NB_MEMORY_LIMIT=4g
NB_SHM_SIZE=2gb
NB_JAVA_OPTS=-XX:MaxRAMPercentage=45.0 -XX:+ExitOnOutOfMemoryError
NB_DNS_PRIMARY=223.5.5.5
NB_DNS_SECONDARY=119.29.29.29
TZ=Asia/Shanghai
