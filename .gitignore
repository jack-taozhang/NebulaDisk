# 运行期数据（转换产物、日志、缓存），不入库
data/
logs/
cache/

# 本地环境配置
.env

# kkFileView 源码（按需 clone，不入库）
src/

# 构建产物
**/target/

# 离线发布包（deploy/export-bundle.sh 的产物，可随时整体重生成）
dist/

# 编辑器与系统文件
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# 本地覆盖（含测试口令等），不入库
.env.local
*.secret
*.key

# Python 缓存（本地跑 py_compile / import 会生成，不该入库）
__pycache__/
*.pyc
*.pyo
kkfileview.zip

# ★ GitHub 令牌（tools/gh-push-api.mjs 的凭据，一行纯 token）★
#   2026-09-30 加：本机 `git push` 两条路都堵 ——
#     · GCM 在非桌面 shell 会卡住（exit 124 挂死）；
#     · github.com 的 HTTPS 时通时断（TCP 443 能连，TLS 握手才挂）。
#   而 api.github.com 一直稳 ⇒ 改走 Git Data API 整树推送（tools/）。
#   令牌只放这个文件，绝不入库。
.gh-token
node_modules/
