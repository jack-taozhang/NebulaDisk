# =============================================================================
# NebulaDisk 离线部署参数
#
#   cp .env.example .env  之后按下面标注改
#
# 标了 ★ 的是**至少必须确认**的项。
# =============================================================================

# ---------------------------------------------------------------------------
# 镜像（本包已含 nebula-1.0.0.tar，一般不用改）
# ---------------------------------------------------------------------------
NB_IMAGE=nebula:1.0.0

# ---------------------------------------------------------------------------
# 端口
# ---------------------------------------------------------------------------
# 云盘界面端口。若被 NAS 上其它服务占用，改这里即可。
NB_HOST_PORT=8089

# ---------------------------------------------------------------------------
# ★ 目录映射（核心配置）★
#
# 左边 = 宿主机真实目录，右边 = 容器内路径，二者必须严格对应：
#
#   volumes:
#     - /volume1/共享:/mnt/share        →  共享|/mnt/share|*
#     - /volume2/照片:/mnt/photos       →  照片|/mnt/photos|*
#     - /volume1/私密:/mnt/private      →  私密|/mnt/private|admin
#
# NAS 上典型路径：
#   群晖   /volume1/xxx
#   威联通 /share/xxx
#   绿联/Ugreen  /mnt/xxx
#   极空间 /sata/xxx
# ---------------------------------------------------------------------------

# ★ 改成你的真实目录。留默认值也能启动（install.sh 会自动建这几个目录）。
NB_SHARE_DIR=./mnt/share
NB_PHOTOS_DIR=./mnt/photos
NB_PRIVATE_DIR=./mnt/private

# 数据目录（SQLite 用户库 + 会话密钥）。**必须持久化**，否则重建容器就丢用户。
NB_DATA_DIR=./data
# kkFileView 转换产物与日志。纯缓存，删了会自动重建（但删后要重启容器）。
NB_KK_FILE_DIR=./data-kk/file
NB_KK_LOG_DIR=./data-kk/log

# ★ 映射声明：显示名|容器内路径|可见用户
#   显示名     = 界面上看到的盘符名字（可用中文）
#   容器内路径 = 与 volumes 右侧完全一致
#   可见用户   = * 表示所有人；也可写 alice,bob；省略等同 *
#   ★ 分隔符是竖线 |，不是冒号 —— 冒号在 Windows 路径里天然存在
NEBULA_MOUNTS=共享|/mnt/share|*;照片|/mnt/photos|*;私密|/mnt/private|admin

# ---------------------------------------------------------------------------
# 云盘
# ---------------------------------------------------------------------------
NB_TITLE=NebulaDisk
NB_ADMIN_USER=admin
# ★ 建议显式设置。留空 = 首启随机生成并打印到容器日志：
#     docker logs nebula 2>&1 | grep 管理员
NB_ADMIN_PASSWORD=
NB_SESSION_HOURS=12
# 单文件上传上限（MB）。超过返回 413。
NB_MAX_UPLOAD_MB=2048
NB_LOG_LEVEL=info

# 会话签名密钥。留空 = 自动生成到 /var/lib/nebula/secret.key 并持久复用。
# 多实例 / 负载均衡时必须显式设成同一个值。
NB_JWT_SECRET=

# ---------------------------------------------------------------------------
# 选填：OnlyOffice（没有就整段不用管）
#
#   没有 OnlyOffice 时，Office 文件（docx/xlsx/pptx）点开会提示走下载，
#   其余格式（PDF/图片/视频/压缩包/代码/CAD）预览全部正常。
# ---------------------------------------------------------------------------
# 服务端地址（容器间互通，用服务名或容器 IP）
NB_OO_URL=http://maple-onlyoffice

# ★ 浏览器地址：必须是用户浏览器能访问到的地址。
#   填 127.0.0.1 只在「浏览器也在同一台机器」时有效；NAS 上必须填 NAS 的 IP 或域名。
NB_OO_PUBLIC=http://192.168.1.10:8082

# ★ 必须与 OnlyOffice 容器的 JWT_SECRET 完全一致
#   查看已有容器：docker inspect maple-onlyoffice | grep -i jwt
NB_OO_SECRET=

# OnlyOffice / cad-viewer 所在的 docker 网络名。
# 用 docker network ls 确认真名；没有 OnlyOffice 时按下面「先建占位网络」做。
NB_OO_NETWORK=nebula-oo

# ---------------------------------------------------------------------------
# ★★ 上游容器回拉文档用的基地址（决定编辑器能不能打开文件）★★
# ---------------------------------------------------------------------------
# 原理：OnlyOffice 是用**它自己的容器**去 GET 文档的，不是浏览器发请求。
#       所以这个地址必须是「OnlyOffice 容器能解析并访问到」的地址。
#
#   正确：http://nebula:8088            ← 同网络用服务名（默认值，一般不用改）
#   错误：http://127.0.0.1:8088         → 那是 OnlyOffice 自己
#   错误：http://<NAS的IP>:8089         → 用了宿主机端口，且容器未必能回连
#
# 注意是**容器端口 8088**，不是宿主机映射端口。
NB_BASE_URL=http://nebula:8088

# ---------------------------------------------------------------------------
# 选填：CAD 图纸查看器（独立的 cad-viewer 服务；没有就整段不用管）
# ---------------------------------------------------------------------------
NB_CAD_URL=http://maple-cad-viewer:8080
NB_CAD_PROBE=http://maple-cad-viewer:8080

# ---------------------------------------------------------------------------
# 资源
# ---------------------------------------------------------------------------
# kkFileView 用 LibreOffice 转换，比较吃内存；NAS 内存紧张时可降到 2g，
# 并把 NB_JAVA_OPTS 的 MaxRAMPercentage 一起调小（代价是转换变慢）。
NB_MEMORY_LIMIT=4g
NB_SHM_SIZE=2gb
NB_JAVA_OPTS=-XX:MaxRAMPercentage=45.0 -XX:+ExitOnOutOfMemoryError
NB_DNS_PRIMARY=223.5.5.5
NB_DNS_SECONDARY=119.29.29.29
TZ=Asia/Shanghai
