# =============================================================================
# NebulaDisk 部署参数
#
#   cp deploy/.env.example <部署目录>/.env
#
# ★ 放在**部署目录**里，不是源码目录 ★
#   编排文件从源码目录取（-f），.env 与数据留在部署目录（--project-directory）。
#   这样源码可以整体替换/更新，而账号、分享、转换缓存都不受影响。
#
# 标了 ★ 的至少必须确认一遍。
# =============================================================================

# ---------------------------------------------------------------------------
# ★ 要起哪些服务 ★
#
#   bundled  = 本编排**自带** OnlyOffice 与 cad-viewer（推荐，自包含）
#   留空     = 只起 nebula；OnlyOffice / cad-viewer 复用**别的 compose 项目**里的
#              ⇒ 那种情况再叠加 deploy/docker-compose.dev.yml，
#                让 nebula 加入它们所在的外部网络（见该文件里的说明）
#
# 写成普通变量而不是命令行参数，就是为了让 `docker compose up -d` 裸跑也对。
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=bundled

# ---------------------------------------------------------------------------
# ★ 源码目录（只有「构建」用得到）★
#
#   build.context 必须是**绝对路径**（Compose 解析它的基准是 --project-directory，
#   不是编排文件所在目录 —— 实测写 `..` 会指到部署目录的上一级）。
#
#   · 用 deploy/up.sh 时**不用管这里**，它会自动算好并覆盖
#   · 手工 `docker compose ... up -d --build` 时才需要填：
#       NB_SRC_DIR=/vol1/1000/Docker/NebulaDisk        （源码根的绝对路径）
# ---------------------------------------------------------------------------
NB_SRC_DIR=

# ---------------------------------------------------------------------------
# 镜像与版本
# ---------------------------------------------------------------------------
NB_VERSION=1.0.0
# 构建 nebula 镜像的**基础镜像**（由仓库根 ./build.sh 用 src/ 构建）
NB_BASE_IMAGE=kkfileview:5.0.2
# 构建期 apt 源加速；留空用镜像自带官方源
NB_APT_MIRROR=mirrors.aliyun.com

# ---------------------------------------------------------------------------
# 端口（左边都是**宿主机**端口，容器内固定 8088 / 80 / 8080）
# ---------------------------------------------------------------------------
NB_HOST_PORT=8089
# kkFileView 直连端口，排查用；需要时把编排里那行 ports 取消注释
NB_KK_HOST_PORT=8013
NB_OO_HOST_PORT=8082
NB_CAD_HOST_PORT=8090

# ---------------------------------------------------------------------------
# ★ 目录（核心配置）★
#
# 写法一：相对路径 —— 相对**部署目录**，自包含，适合新建部署
#   NB_DATA_DIR=./data
#
# 写法二：绝对路径 —— 指向已有部署目录，**接管既有数据**（推荐换编排时用）
#   NB_DATA_DIR=/volume1/nebula/data
#
# 群晖 /volume1/xxx · 威联通 /share/xxx · 绿联 /mnt/xxx · 极空间 /sata/xxx
# ---------------------------------------------------------------------------

# 云盘数据（SQLite 用户库 + 会话密钥）。**必须持久化**，否则重建容器就丢用户。
NB_DATA_DIR=./data
# kkFileView 转换产物与日志（纯缓存，删了会自动重建，删后需重启容器）
NB_KK_FILE_DIR=./data-kk/file
NB_KK_LOG_DIR=./data-kk/log

# ---------------------------------------------------------------------------
# ★★ 共享盘（要挂几个盘就写几行，**数量不限**）★★
#
#   格式：  显示名|宿主机路径|容器内路径|可见用户     多条用 ; 分隔
#
#     显示名      界面上看到的盘符名，可用中文
#     宿主机路径  绝对路径，或相对**部署目录**的相对路径（如 ./mnt/share）
#     容器内路径  必须以 /mnt/ 开头（避免误盖数据目录）；改它不会影响用户数据
#     可见用户    * 所有人；或 alice,bob；省略等同 *
#
#   ★ 这里是**唯一**要改的地方 ★
#     compose 里的 volumes 绑定与容器内的 NEBULA_MOUNTS 都由这一行**机械派生**
#     （deploy/gen-mounts.py），所以两者不可能对不上。
#     以前要在两个文件三处改、还要保证逐字一致 —— 加第 4 个盘时最容易错。
#
#   加一个盘：
#     ① 在下面加一段，例如：  图纸|/vol1/1000/图纸|/mnt/图纸|*
#     ② 重跑：  bash deploy/up.sh <部署目录>
#       （up.sh 会自动重新生成挂载文件并重建容器；宿主机目录不存在会自动建）
#
#   ★ 分隔符是竖线 |，不是冒号（冒号在 Windows 盘符、UNC、URL 里天然存在）
#   ★ 路径里**不要**再出现 | 或 ;
# ---------------------------------------------------------------------------
NB_MOUNTS=共享|./mnt/share|/mnt/share|*;照片|./mnt/photos|/mnt/photos|*;私密|./mnt/private|/mnt/private|admin

# OnlyOffice 的四个数据目录。可写宿主目录，也可写**卷名**（用命名卷，更省心）。
# ★ 用宿主目录时，属主必须是 OnlyOffice 的 ds(101:102)，否则转换会 EPERM
NB_OO_DATA_DIR=oo-data
NB_OO_LOG_DIR=oo-logs
NB_OO_LIB_DIR=oo-lib
NB_OO_DB_DIR=oo-db

# ---------------------------------------------------------------------------
# 云盘
# ---------------------------------------------------------------------------
NB_TITLE=NebulaDisk
NB_ADMIN_USER=admin
# ★ 建议显式设置。留空 = 首启随机生成并打进容器日志：
#     docker logs nebula 2>&1 | grep 管理员
NB_ADMIN_PASSWORD=
NB_SESSION_HOURS=12
NB_MAX_UPLOAD_MB=2048
NB_LOG_LEVEL=info
# 会话签名密钥。留空 = 自动生成到 /var/lib/nebula/secret.key 并持久复用。
# 多实例部署时必须显式设成同一个值。
NB_JWT_SECRET=

# ---------------------------------------------------------------------------
# ★ OnlyOffice ★（本编排内置为兄弟服务，同网络按服务名互通）
# ---------------------------------------------------------------------------
NB_OO_VERSION=latest

# 服务端地址（容器间）：用**服务名 + 容器端口 80**
NB_OO_URL=http://onlyoffice:80
# ★ 浏览器地址：必须是**用户浏览器**能访问到的地址。
#   填 127.0.0.1 只在「浏览器也在同一台机器」时有效；NAS 上要填 NAS 的 IP/域名。
NB_OO_PUBLIC=http://192.168.1.10:8082

# ★★ 必须设置，且与 OnlyOffice 的 JWT_SECRET 完全一致 ★★
#   （本编排里两边读的是同一个变量，所以只要这里设了就不会不一致。
#     但若你复用**已有的** OnlyOffice 容器，就必须填它那个 JWT_SECRET。）
#   留空会**直接启动失败**（编排里写的是 ${NB_OO_SECRET:?...}）—— 故意的：
#   让它 fail fast，而不是启动后表现为「文档打不开」。
NB_OO_SECRET=

# ★ raw 取流直链的对外基地址（决定编辑器能不能打开文件）
#   原理：OnlyOffice 是用**它自己的容器**去 GET 文档的，不是浏览器发请求。
#   所以必须是「OnlyOffice 容器能解析并访问到」的地址：
#      正确 http://nebula:8088      （同网络服务名 + **容器端口 8088**）
#      错误 http://127.0.0.1:8088   （那是 OnlyOffice 自己）
#      错误 http://<NAS_IP>:8089    （宿主机端口，容器未必能回连）
NB_BASE_URL=http://nebula:8088

# ---------------------------------------------------------------------------
# CAD 图纸查看器（不挂任何卷，无状态）
#   ★ 只填 NB_CAD_URL 就够了 —— 它是**容器间**可达地址（反代的目标）。
#     另有一个 NEBULA_CAD_PROBE 是「探活专用地址」，缺省会**自动取 NB_CAD_URL**，
#     只有当你把 CAD 放到别的反代路径后面、两个地址确实不同时才需要单独设。
# ---------------------------------------------------------------------------
NB_CAD_VERSION=1.7.0
NB_CAD_URL=http://cad-viewer:8080

# ---------------------------------------------------------------------------
# 资源
# ---------------------------------------------------------------------------
# kkFileView 用 LibreOffice 转换，比较吃内存；NAS 内存紧张时降到 2g，
# 并把 NB_JAVA_OPTS 的 MaxRAMPercentage 一起调小（代价是转换变慢）。
NB_MEMORY_LIMIT=4g
# LibreOffice 无头转换用 /dev/shm，默认 64MB 会让 soffice 被 SIGABRT 杀掉
NB_SHM_SIZE=2gb
NB_JAVA_OPTS=-XX:MaxRAMPercentage=45.0 -XX:+ExitOnOutOfMemoryError
NB_DNS_PRIMARY=223.5.5.5
NB_DNS_SECONDARY=119.29.29.29
TZ=Asia/Shanghai
