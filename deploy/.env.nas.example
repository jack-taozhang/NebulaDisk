# ★ 这是**脱敏模板**，照着改；真值请写进部署目录的 .env，不要提交 ★
# 本文件由一次真实的「旧 allinone 部署 → 新 deploy/ 编排」迁移整理而来。
# =============================================================================
# NebulaDisk 部署参数 —— NAS (TPNAS) 生产部署
#
#   部署目录：/vol1/1000/NebulaDisk
#   源码目录：/vol1/1000/Docker/NebulaDisk
#
#   ★ 这份是按原有 allinone 部署「接管既有数据」写出来的 ★
#     目录、账号、JWT 密钥、OnlyOffice 对外地址全部沿用旧值，
#     所以切换编排后用户、分享链接、上传的文件、OO 的转换缓存都不受影响。
#
#   迁移动机：旧编排（allinone）每个服务一个独立 compose 文件、.env 散落，
#   改成 deploy/ 这套「一个可 build 的编排 + 一个 .env」。
# =============================================================================

# ---------------------------------------------------------------------------
# 起哪些服务：bundled = 云盘 + OnlyOffice + cad-viewer 全在本编排内
# ---------------------------------------------------------------------------
COMPOSE_PROFILES=bundled

# ---------------------------------------------------------------------------
# 源码根绝对路径
#   ★ 看似「只有构建才用」，但编排里写的是 ${NB_SRC_DIR:?...}，
#     Compose 解析时会**整份插值**，所以即使只 `up -d`（不 build）
#     也必须能取到值，否则直接报错。所以这里必须填。
# ---------------------------------------------------------------------------
NB_SRC_DIR=/vol1/1000/Docker/NebulaDisk   # ← 源码根绝对路径

# ---------------------------------------------------------------------------
# 镜像与版本
# ---------------------------------------------------------------------------
NB_VERSION=1.0.0
NB_BASE_IMAGE=kkfileview:5.0.2
NB_APT_MIRROR=mirrors.aliyun.com

# ---------------------------------------------------------------------------
# 端口（左边宿主机，容器内固定 8088 / 80 / 8080）
# ---------------------------------------------------------------------------
NB_HOST_PORT=8089
NB_KK_HOST_PORT=8012
NB_OO_HOST_PORT=8082
NB_CAD_HOST_PORT=8090

# ---------------------------------------------------------------------------
# 数据目录（相对部署目录；均为旧部署已在用的路径 → 数据原地接管）
# ---------------------------------------------------------------------------
NB_DATA_DIR=./data
NB_KK_FILE_DIR=./data-kk/file
NB_KK_LOG_DIR=./data-kk/log

# ---------------------------------------------------------------------------
# ★★ 共享盘：要挂几个就写几行，数量不限 ★★
#   格式：显示名|宿主机路径|容器内路径|可见用户     多条用 ; 分隔
#
#   旧 allinone 编排挂的是 /vol1/1000/{售前项目,研发立项,项目设计}，容器内是
#   /mnt/<同名>；新编排统一用 /mnt/share|photos|private（更中性）。容器内路径
#   只影响挂载点，不影响用户数据。
#
#   ★ 加盘：加一段，然后重跑 deploy/up.sh。compose 里的绑定与容器内的
#     NEBULA_MOUNTS 都由这一行机械派生，不会再出现"两处对不上"。
# ---------------------------------------------------------------------------
NB_MOUNTS=售前项目|/vol1/1000/售前项目|/mnt/share|*;研发立项|/vol1/1000/研发立项|/mnt/photos|*;项目设计|/vol1/1000/项目设计|/mnt/private|*

# ---------------------------------------------------------------------------


# ---------------------------------------------------------------------------
# OnlyOffice 数据目录（沿用旧部署的宿主目录，保留转换缓存与数据库）
#   ★ 属主必须是 ds(101:102)，否则 converter 会 EACCES ★
# ---------------------------------------------------------------------------
NB_OO_DATA_DIR=./onlyoffice/data
NB_OO_LOG_DIR=./onlyoffice/logs
NB_OO_LIB_DIR=./onlyoffice/lib
NB_OO_DB_DIR=./onlyoffice/db

# ---------------------------------------------------------------------------
# 云盘
# ---------------------------------------------------------------------------
NB_TITLE=NebulaDisk
NB_ADMIN_USER=<你的管理员用户名>
NB_ADMIN_PASSWORD=<改成你自己的强口令>
NB_SESSION_HOURS=12
NB_MAX_UPLOAD_MB=2048
NB_LOG_LEVEL=info
# 留空 = 复用 /var/lib/nebula/secret.key（已存在 → 老会话与分享链接继续有效）
NB_JWT_SECRET=

# ---------------------------------------------------------------------------
# OnlyOffice
# ---------------------------------------------------------------------------
NB_OO_VERSION=latest
# 容器间：服务名 + 容器端口 80
NB_OO_URL=http://onlyoffice:80
# ★ 浏览器地址：沿用旧部署的对外地址（用户书签/链接里就是它）
NB_OO_PUBLIC=http://<NAS 的局域网 IP>:8082
# ★★ 与 OnlyOffice 的 JWT_SECRET 必须一致；沿用旧值 ★★
NB_OO_SECRET=<与 OnlyOffice 的 JWT_SECRET 一致；本编排两边读同一变量>
# raw 直链对外基地址（OnlyOffice 容器视角）
NB_BASE_URL=http://nebula:8088

# ---------------------------------------------------------------------------
# CAD 查看器
#   ★ 只填 NB_CAD_URL 就够了（容器间可达地址）。探活地址缺省自动取它。
# ---------------------------------------------------------------------------
NB_CAD_VERSION=1.7.0
NB_CAD_URL=http://cad-viewer:8080

# ---------------------------------------------------------------------------
# 资源
# ---------------------------------------------------------------------------
NB_MEMORY_LIMIT=4g
NB_SHM_SIZE=2gb
NB_JAVA_OPTS=-XX:MaxRAMPercentage=45.0 -XX:+ExitOnOutOfMemoryError
NB_DNS_PRIMARY=223.5.5.5
NB_DNS_SECONDARY=119.29.29.29
TZ=Asia/Shanghai
